# Whale Sentry Skill - Environment Variables
# Copy this file to .env and fill in your API keys

# ===========================================
# REQUIRED - At least one blockchain API key
# ===========================================

# Etherscan - Ethereum & Base (Free: 5 calls/sec, 100k/day)
# Get at: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_key_here

# Solscan - Solana (Free tier available)
# Get at: https://solscan.io/api
SOLSCAN_API_KEY=your_solscan_key_here

# Solana FM - Solana alternative (Free tier available)
# Get at: https://solana.fm/developers
SOLANA_FM_API_KEY=your_solana_fm_key_here

# Covalent - Multi-chain (Free: 1M calls/month)
# Get at: https://www.covalenthq.com/
COVALENT_API_KEY=your_covalent_key_here

# Alchemy - Enhanced Ethereum/Base (Free: 300M CU/month)
# Get at: https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_key_here

# ===========================================
# REQUIRED - NVIDIA API for AI Analysis
# ===========================================
# Get at: https://www.nvidia.com/en-us/ai/
NVIDIA_API_KEY=your_nvidia_api_key_here

# ===========================================
# OPTIONAL - Telegram Alerts
# ===========================================
# Create bot at: https://t.me/BotFather
# Get chat ID from: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ===========================================
# OPTIONAL - Monitoring Thresholds
# ===========================================
WHALE_THRESHOLD_ETH=100          # ETH amount to trigger alert
WHALE_THRESHOLD_SOL=5000         # SOL amount to trigger alert
WHALE_THRESHOLD_USD=100000       # USD value to trigger alert
CHECK_INTERVAL=60                # Seconds between checks (default: 60)