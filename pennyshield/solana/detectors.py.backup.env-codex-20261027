# === Early Snipe & Bundle Detector ===
class EarlySnipeDetector(RiskIndicator):
    """Detect early sniping and bundled buys at launch."""

    def __init__(self, launch_window_blocks: int = 5,
                 concentration_threshold: float = 0.3,
                 min_bundle_wallets: int = 3,
                 min_shared_funders: int = 3):
        super().__init__("early_snipe", weight=2.0)
        if launch_window_blocks < 0:
            raise ValueError("launch_window_blocks must be non-negative")
        if not 0 < concentration_threshold <= 1:
            raise ValueError("concentration_threshold must be in (0, 1]")
        if min_bundle_wallets < 2 or min_shared_funders < 2:
            raise ValueError("wallet thresholds must be at least 2")
        self.launch_window_blocks = launch_window_blocks
        self.concentration_threshold = concentration_threshold
        self.min_bundle_wallets = min_bundle_wallets
        self.min_shared_funders = min_shared_funders

    def evaluate(self, context: DetectionContext) -> IndicatorResult:
        launch_block = context.token_data.get('launch_block', 0)
        if not launch_block:
            return IndicatorResult(
                indicator=self.name, triggered=False, confidence=0.0,
                evidence={'reason': 'no_launch_block_data'},
                explanation="Cannot determine launch block"
            )

        launch_txs = []
        for tx in context.transactions:
            try:
                block = int(tx.get('block', 0))
            except (TypeError, ValueError):
                continue
            if launch_block <= block <= launch_block + self.launch_window_blocks:
                launch_txs.append(tx)

        if not launch_txs:
            return IndicatorResult(
                indicator=self.name, triggered=False, confidence=0.0,
                evidence={'reason': 'no_launch_transactions'},
                explanation="No transactions in launch window"
            )

        wallet_buys = defaultdict(lambda: {
            'amount': 0.0, 'txns': [], 'blocks': defaultdict(float)
        })
        for tx in launch_txs:
            if not self._is_buy(tx):
                continue
            buyer = self._extract_buyer(tx)
            if not buyer:
                continue
            try:
                amount = float(self._extract_token_amount(tx))
                block = int(tx.get('block', 0))
            except (TypeError, ValueError):
                continue
            if amount <= 0 or amount != amount or amount == float('inf'):
                continue
            wallet_buys[buyer]['amount'] += amount
            wallet_buys[buyer]['txns'].append(tx)
            wallet_buys[buyer]['blocks'][block] += amount

        bundled_groups, funder_amounts = self._detect_bundles(
            wallet_buys, context.wallet_graph)
        shared_funders = self._detect_shared_funding(
            wallet_buys, context.wallet_graph, self.min_shared_funders)

        concentration_scores = {}
        for funder, amounts_by_wallet in funder_amounts.items():
            total = sum(amounts_by_wallet.values())
            if total > 0:
                concentration_scores[funder] = sum(
                    (amount / total) ** 2 for amount in amounts_by_wallet.values()
                )

        high_concentration = any(
            score >= self.concentration_threshold
            for score in concentration_scores.values()
        )
        large_bundle = any(
            len(group['wallets']) >= self.min_bundle_wallets
            for group in bundled_groups
        )
        has_shared_funder = bool(shared_funders)
        triggered = (high_concentration or large_bundle) and has_shared_funder

        max_concentration = max(concentration_scores.values(), default=0.0)
        confidence = min(
            len(bundled_groups) * 0.4 + len(shared_funders) * 0.3
            + max_concentration * 0.3,
            1.0
        )
        return IndicatorResult(
            indicator=self.name,
            triggered=triggered,
            confidence=confidence,
            evidence={
                'launch_window_blocks': self.launch_window_blocks,
                'launch_transactions': len(launch_txs),
                'buy_transactions': sum(len(data['txns']) for data in wallet_buys.values()),
                'unique_buyers': len(wallet_buys),
                'funder_hhi': concentration_scores,
                'bundled_groups': bundled_groups,
                'shared_funders': shared_funders,
                'concentration_threshold': self.concentration_threshold,
                'min_bundle_wallets': self.min_bundle_wallets,
                'min_shared_funders': self.min_shared_funders,
            },
            explanation=self._build_explanation(
                triggered, bundled_groups, max_concentration, shared_funders)
        )

    def _is_buy(self, tx: Dict) -> bool:
        """Use explicit normalized direction; unknown transaction side is excluded."""
        explicit = tx.get('is_buy')
        if isinstance(explicit, bool):
            return explicit
        side = tx.get('side') or tx.get('type')
        return isinstance(side, str) and side.strip().lower() in {'buy', 'token_buy'}

    def _extract_buyer(self, tx: Dict) -> Optional[str]:
        return tx.get('buyer') or tx.get('from')

    def _extract_token_amount(self, tx: Dict) -> int:
        return tx.get('token_amount', 0)

    def _wallet_funders(self, wallet: str, wallet_graph: WalletGraph):
        node = wallet_graph.nodes.get(wallet)
        funders = getattr(node, 'funding_sources', ()) if node else ()
        if isinstance(funders, str):
            return {funders}
        return set(funders or ())

    def _detect_bundles(self, wallet_buys: Dict, wallet_graph: WalletGraph):
        """Group same-block buy amounts by shared funder and distinct wallet."""
        groups = defaultdict(dict)
        funder_amounts = defaultdict(lambda: defaultdict(float))
        for wallet, data in wallet_buys.items():
            funders = self._wallet_funders(wallet, wallet_graph)
            for block, amount in data['blocks'].items():
                for funder in funders:
                    groups[(block, funder)][wallet] = (
                        groups[(block, funder)].get(wallet, 0.0) + amount
                    )
            for funder in funders:
                funder_amounts[funder][wallet] += data['amount']

        bundles = []
        for (block, funder), buyer_amounts in groups.items():
            if len(buyer_amounts) < self.min_bundle_wallets:
                continue
            amounts = list(buyer_amounts.values())
            if min(amounts) <= 0 or max(amounts) / min(amounts) >= 5:
                continue
            bundles.append({
                'block': block, 'funder': funder,
                'wallets': sorted(buyer_amounts),
                'total_amount': sum(amounts),
                'avg_amount': sum(amounts) / len(amounts),
            })
        return bundles, funder_amounts

    def _detect_shared_funding(self, wallet_buys: Dict, wallet_graph: WalletGraph,
                               min_wallets: int = 2) -> List[Dict]:
        """Find funders linked to the configured minimum number of launch buyers."""
        funder_groups = defaultdict(list)
        for wallet in wallet_buys:
            for funder in self._wallet_funders(wallet, wallet_graph):
                funder_groups[funder].append(wallet)
        return [
            {'funder': funder, 'wallets': sorted(set(wallets)),
             'count': len(set(wallets))}
            for funder, wallets in funder_groups.items()
            if len(set(wallets)) >= min_wallets
        ]

    def _build_explanation(self, triggered: bool, bundles: List,
                           max_concentration: float,
                           shared_funders: List) -> str:
        parts = []
        if bundles:
            parts.append(f"{len(bundles)} shared-funder bundle group(s) detected")
        if max_concentration >= self.concentration_threshold:
            parts.append(f"maximum funder-group HHI is {max_concentration:.3f}")
        if shared_funders:
            parts.append(f"{len(shared_funders)} shared funder(s) detected")
        if not parts:
            return "No coordinated launch activity detected"
        return "; ".join(parts)


# === Deployer Intelligence Detector ===
class DeployerIntelligenceDetector(RiskIndicator):
    """Track deployer history and repeat launch patterns"""
    
    def __init__(self, evidence_store: EvidenceStore, 
                 repeat_threshold: int = 3, rug_rate_threshold: float = 0.5):
        super().__init__("deployer_intelligence", weight=2.5)
        self.evidence_store = evidence_store
        self.repeat_threshold = repeat_threshold
        self.rug_rate_threshold = rug_rate_threshold
    
    def evaluate(self, context: DetectionContext) -> IndicatorResult:
        deployer = context.token_data.get('creator', '')
        if not deployer:
            return IndicatorResult(
                indicator=self.name,
                triggered=False,
                confidence=0.0,
                evidence={'reason': 'no_deployer_data'},
                explanation="Deployer address not available"
            )
        
        # Get deployer history from evidence store
        operator_sig = f"deployer:{deployer}"
        history = self.evidence_store.get_operator_history(operator_sig)
        
        total_launches = len(history)
        if total_launches == 0:
            return IndicatorResult(
                indicator=self.name,
                triggered=False,
                confidence=0.0,
                evidence={'deployer': deployer, 'total_launches': 0},
                explanation="First known launch for this deployer"
            )
        
        # Count confirmed rugs (deduplicated by token address)
        confirmed_rugs = [h for h in history if h.get('outcome') == 'rug']
        confirmed_rug_tokens = set()
        for h in confirmed_rugs:
            token = h.get('token_address')
            if token:
                confirmed_rug_tokens.add(token)
        confirmed_rug_count = len(confirmed_rug_tokens)
        
        # Count total launches (deduplicated by token address)
        launch_tokens = set()
        for h in history:
            token = h.get('token_address')
            if token:
                launch_tokens.add(token)
        total_unique_launches = len(launch_tokens)
        
        # Calculate rug rate based on unique launches
        rug_rate = confirmed_rug_count / total_unique_launches if total_unique_launches > 0 else 0
        
        # Check for repeat pattern
        is_repeat = total_unique_launches >= self.repeat_threshold
        high_rug_rate = confirmed_rug_count / total_unique_launches >= self.rug_rate_threshold if total_unique_launches > 0 else False
        
        # Serial rug operator: 3+ distinct confirmed rug outcomes
        serial_rug_operator = confirmed_rug_count >= 3
        
        # Trigger on high rug rate OR serial rug operator
        triggered = (is_repeat and high_rug_rate) or serial_rug_operator
        
        # Confidence: serial rug operator gets high confidence, otherwise based on rug rate
        if serial_rug_operator:
            confidence = min(confirmed_rug_count * 0.35, 1.0)  # Slightly higher weight
        elif is_repeat:
            confidence = min(rug_rate * 1.5, 1.0)
        else:
            confidence = rug_rate
        
        # Get recent launches
        recent = sorted(history, key=lambda x: x.get('timestamp', 0), reverse=True)[:5]
        
        return IndicatorResult(
            indicator=self.name,
            triggered=triggered,
            confidence=confidence,
            evidence={
                'deployer': deployer,
                'total_launches': total_unique_launches,
                'confirmed_rug_count': confirmed_rug_count,
                'rug_rate': confirmed_rug_count / total_unique_launches if total_unique_launches > 0 else 0,
                'serial_rug_operator': serial_rug_operator,
                'recent_launches': [
                    {
                        'token': h.get('token_address'),
                        'timestamp': h.get('timestamp'),
                        'outcome': h.get('outcome'),
                        'risk_score': h.get('risk_score')
                    }
                    for h in recent
                ],
                'repeat_threshold': self.repeat_threshold,
                'rug_rate_threshold': self.rug_rate_threshold
            },
            explanation=self._build_explanation(deployer, total_unique_launches, confirmed_rug_count, rug_rate, triggered, serial_rug_operator)
        )
    
    def _build_explanation(self, deployer: str, total: int, rugs: int, 
                           rug_rate: float, triggered: bool, serial_rug_operator: bool = False) -> str:
        if total == 0:
            return "First known launch"
        if serial_rug_operator:
            return f"Deployer {deployer[:8]}... is serial rug operator: {total} launches, {rugs} confirmed rugs"
        if triggered:
            return f"Deployer {deployer[:8]}... has {total} launches with {rug_rate:.1%} rug rate"
        return f"Deployer {deployer[:8]}... has {total} launches, {rugs} rugs ({rug_rate:.1%})"


# === Wallet Clustering Detector ===
class WalletClusteringDetector(RiskIndicator):
    """Probabilistic wallet clustering to identify related insiders"""
    
    def __init__(self, min_cluster_size: int = 3, 
                 funding_weight: float = 0.4,
                 co_trade_weight: float = 0.3,
                 transfer_weight: float = 0.2,
                 timing_weight: float = 0.1):
        super().__init__("wallet_clustering", weight=2.0)
        self.min_cluster_size = min_cluster_size
        self.weights = {
            'funding': funding_weight,
            'co_trade': co_trade_weight,
            'transfer': transfer_weight,
            'timing': timing_weight
        }
    
    def evaluate(self, context: DetectionContext) -> IndicatorResult:
        # Build similarity matrix
        wallets = list(context.wallet_graph.nodes.keys())
        if len(wallets) < self.min_cluster_size:
            return IndicatorResult(
                indicator=self.name,
                triggered=False,
                confidence=0.0,
                evidence={'wallet_count': len(wallets), 'min_required': self.min_cluster_size},
                explanation="Insufficient wallets for clustering"
            )
        
        # Calculate pairwise similarities
        clusters = self._cluster_wallets(context.wallet_graph, wallets)
        
        # Filter significant clusters
        significant = [c for c in clusters if len(c['wallets']) >= self.min_cluster_size]
        
        # Calculate concentration per cluster and assign cluster_id to graph nodes
        for i, cluster in enumerate(significant):
            cluster['supply_pct'] = self._calculate_cluster_supply(cluster, context)
            # Assign cluster_id to graph nodes for use by other detectors
            cluster_id = f"cluster_{i}"
            for wallet in cluster['wallets']:
                if wallet in context.wallet_graph.nodes:
                    context.wallet_graph.nodes[wallet].cluster_id = cluster_id
        
        triggered = len(significant) > 0
        confidence = min(len(significant) * 0.2 + max(c['supply_pct'] for c in significant) if significant else 0, 1.0)
        
        return IndicatorResult(
            indicator=self.name,
            triggered=triggered,
            confidence=confidence,
            evidence={
                'total_wallets': len(wallets),
                'clusters_found': len(clusters),
                'significant_clusters': len(significant),
                'clusters': significant,
                'min_cluster_size': self.min_cluster_size
            },
            explanation=f"Found {len(significant)} significant wallet cluster(s)" if triggered else "No significant clusters"
        )
    
    def _cluster_wallets(self, graph: WalletGraph, wallets: List[str]) -> List[Dict]:
        """Cluster wallets using multiple similarity signals"""
        # Build adjacency matrix with weighted edges
        similarities = defaultdict(float)
        
        for wallet in wallets:
            node = graph.nodes[wallet]
            
            # Funding relationships
            for funder in node.funding_sources:
                if funder in graph.nodes:
                    similarities[(wallet, funder)] += self.weights['funding']
                    similarities[(funder, wallet)] += self.weights['funding']
            
            for funded in node.funded_wallets:
                if funded in graph.nodes:
                    similarities[(wallet, funded)] += self.weights['funding']
        
        # Co-trading relationships (from edges)
        for from_addr, edges in graph.edges.items():
            for edge in edges:
                if edge.edge_type == 'co_traded':
                    similarities[(from_addr, edge.to_addr)] += self.weights['co_trade']
                elif edge.edge_type == 'transferred':
                    similarities[(from_addr, edge.to_addr)] += self.weights['transfer']
        
        # Simple clustering: group by strong connections
        visited = set()
        clusters = []
        
        for wallet in wallets:
            if wallet in visited:
                continue
            cluster = self._expand_cluster(wallet, similarities, wallets, visited)
            if len(cluster) >= 2:
                clusters.append({'wallets': cluster, 'avg_similarity': self._avg_similarity(cluster, similarities)})
        
        return sorted(clusters, key=lambda c: c['avg_similarity'], reverse=True)
    
    def _expand_cluster(self, seed: str, similarities: Dict, wallets: List[str], visited: Set) -> List[str]:
        cluster = [seed]
        visited.add(seed)
        
        # BFS to find all connected wallets (transitive through shared funders, etc.)
        queue = [seed]
        while queue:
            current = queue.pop(0)
            for other in wallets:
                if other not in visited:
                    key = (current, other) if (current, other) in similarities else (other, current)
                    if similarities.get(key, 0) >= 0.3:  # Lower threshold for combined signals
                        cluster.append(other)
                        visited.add(other)
                        queue.append(other)
        
        return cluster
    
    def _avg_similarity(self, cluster: List[str], similarities: Dict) -> float:
        if len(cluster) < 2:
            return 0.0
        total = 0
        count = 0
        for i, w1 in enumerate(cluster):
            for w2 in cluster[i+1:]:
                key = (w1, w2) if (w1, w2) in similarities else (w2, w1)
                total += similarities.get(key, 0)
                count += 1
        return total / count if count > 0 else 0.0
    
    def _calculate_cluster_supply(self, cluster: Dict, context: DetectionContext) -> float:
        """Calculate what % of token supply cluster holds"""
        total_supply = context.token_data.get('total_supply', 1)
        cluster_holdings = 0
        
        for wallet in cluster['wallets']:
            if wallet in context.wallet_graph.nodes:
                node = context.wallet_graph.nodes[wallet]
                cluster_holdings += node.tokens_held.get(context.token_address, 0)
        
        return cluster_holdings / total_supply if total_supply > 0 else 0.0


# === Distribution Detector (Artificial Price Floor) ===
class DistributionDetector(RiskIndicator):
    """Detect linked wallets selling into demand while others support price
    
    Distinguishes accumulation phase (coordinated launch buys) from distribution phase
    (coordinated subsequent sells). Launch-phase coordinated buys by a cluster are
    tracked as "accumulation" not "price support" when the same cluster later sells.
    """
    
    def __init__(self, min_price_support_ratio: float = 0.3,
                 min_sell_volume_ratio: float = 0.2,
                 launch_window_blocks: int = 10):
        super().__init__("distribution", weight=2.0)
        self.min_price_support_ratio = min_price_support_ratio
        self.min_sell_volume_ratio = min_sell_volume_ratio
        self.launch_window_blocks = launch_window_blocks
    
    def evaluate(self, context: DetectionContext) -> IndicatorResult:
        # Determine launch block from token data
        launch_block = context.token_data.get('launch_block', 0)
        
        # Group transactions by cluster, separating launch-phase (accumulation) from post-launch
        cluster_activity = defaultdict(lambda: {
            'accumulation_buys': 0, 'accumulation_buy_volume': 0,
            'distribution_sells': 0, 'distribution_sell_volume': 0,
            'post_launch_buys': 0, 'post_launch_buy_volume': 0,
            'wallets': set()
        })
        
        for tx in context.transactions:
            wallet = self._extract_wallet(tx)
            if not wallet or wallet not in context.wallet_graph.nodes:
                continue
            
            node = context.wallet_graph.nodes[wallet]
            cluster_id = node.cluster_id or wallet
            
            block = tx.get('block', 0)
            is_launch_phase = launch_block > 0 and launch_block <= block <= launch_block + self.launch_window_blocks
            
            if self._is_buy(tx):
                if is_launch_phase:
                    cluster_activity[cluster_id]['accumulation_buys'] += 1
                    cluster_activity[cluster_id]['accumulation_buy_volume'] += self._extract_volume(tx)
                else:
                    cluster_activity[cluster_id]['post_launch_buys'] += 1
                    cluster_activity[cluster_id]['post_launch_buy_volume'] += self._extract_volume(tx)
            else:
                cluster_activity[cluster_id]['distribution_sells'] += 1
                cluster_activity[cluster_id]['distribution_sell_volume'] += self._extract_volume(tx)
            
            cluster_activity[cluster_id]['wallets'].add(wallet)
        
        # Find clusters with high distribution sell pressure and low independent buy support
        suspicious = []
        for cluster_id, activity in cluster_activity.items():
            # Skip if no distribution sells
            if activity['distribution_sell_volume'] == 0:
                continue
            
            # Calculate distribution-phase ratios (excluding accumulation phase)
            total_dist_vol = activity['distribution_sell_volume'] + activity['post_launch_buy_volume']
            if total_dist_vol == 0:
                continue
            
            sell_ratio = activity['distribution_sell_volume'] / total_dist_vol
            buy_ratio = activity['post_launch_buy_volume'] / total_dist_vol
            
            # Distribution phase: high sell pressure, low independent buy support
            if sell_ratio > self.min_sell_volume_ratio and buy_ratio < self.min_price_support_ratio:
                # Check if this cluster holds significant supply
                supply_pct = self._cluster_supply_pct(cluster_id, context)
                if supply_pct > 0.05:  # >5% of supply
                    suspicious.append({
                        'cluster_id': cluster_id,
                        'sell_ratio': sell_ratio,
                        'buy_ratio': buy_ratio,
                        'supply_pct': supply_pct,
                        'wallets': list(activity['wallets']),
                        'distribution_sell_volume': activity['distribution_sell_volume'],
                        'post_launch_buy_volume': activity['post_launch_buy_volume'],
                        'accumulation_buy_volume': activity['accumulation_buy_volume']
                    })
        
        triggered = len(suspicious) > 0
        confidence = min(len(suspicious) * 0.3 + max(s['supply_pct'] for s in suspicious) if suspicious else 0, 1.0)
        
        return IndicatorResult(
            indicator=self.name,
            triggered=triggered,
            confidence=confidence,
            evidence={
                'suspicious_clusters': suspicious,
                'total_clusters': len(cluster_activity),
                'min_sell_volume_ratio': self.min_sell_volume_ratio,
                'min_price_support_ratio': self.min_price_support_ratio,
                'launch_window_blocks': self.launch_window_blocks
            },
            explanation=f"Found {len(suspicious)} cluster(s) distributing into demand" if triggered else "No distribution pattern detected"
        )
    
    def _extract_wallet(self, tx: Dict) -> Optional[str]:
        return tx.get('wallet') or tx.get('from') or tx.get('to')
    
    def _is_buy(self, tx: Dict) -> bool:
        return tx.get('type') == 'buy' or tx.get('side') == 'buy'
    
    def _extract_volume(self, tx: Dict) -> float:
        return tx.get('volume_usd', tx.get('amount', 0))
    
    def _cluster_supply_pct(self, cluster_id: str, context: DetectionContext) -> float:
        total_supply = context.token_data.get('total_supply', 1)
        holdings = 0
        for wallet in context.wallet_graph.nodes:
            node = context.wallet_graph.nodes[wallet]
            if node.cluster_id == cluster_id:
                holdings += node.tokens_held.get(context.token_address, 0)
        return holdings / total_supply if total_supply > 0 else 0.0


# === Exit/Liquidity Drain Detector ===
class ExitDetector(RiskIndicator):
    """Detect coordinated exits, liquidity withdrawals, and rug pulls"""
    
    def __init__(self, liquidity_drop_threshold: float = 0.3,
                 large_transfer_threshold: float = 0.1):
        super().__init__("exit_detector", weight=2.5)
        self.liquidity_drop_threshold = liquidity_drop_threshold
        self.large_transfer_threshold = large_transfer_threshold
    
    def evaluate(self, context: DetectionContext) -> IndicatorResult:
        signals = []
        
        # Check liquidity drop
        pool_liq = context.pool_data.get('liquidity_usd', 0)
        prev_liq = context.historical_data.get('previous_liquidity_usd', pool_liq)
        if prev_liq > 0:
            drop_pct = (prev_liq - pool_liq) / prev_liq
            if drop_pct > self.liquidity_drop_threshold:
                signals.append({
                    'type': 'liquidity_drop',
                    'drop_percentage': drop_pct,
                    'previous_liquidity': prev_liq,
                    'current_liquidity': pool_liq
                })
        
        # Check for large insider transfers
        for tx in context.transactions:
            if self._is_large_transfer(tx, context):
                signals.append({
                    'type': 'large_transfer',
                    'from': tx.get('from'),
                    'to': tx.get('to'),
                    'amount': tx.get('amount', 0),
                    'token': context.token_address
                })
        
        # Check for deployer activity
        deployer = context.token_data.get('creator', '')
        if deployer:
            deployer_txs = [tx for tx in context.transactions if tx.get('from') == deployer or tx.get('to') == deployer]
            if deployer_txs:
                signals.append({
                    'type': 'deployer_activity',
                    'deployer': deployer,
                    'transactions': len(deployer_txs),
                    'details': deployer_txs[:5]
                })
        
        # Check for pool closure/graduation (Pump.fun specific)
        if context.chain == 'solana':
            curve_complete = context.pool_data.get('bonding_curve_complete', False)
            if curve_complete:
                signals.append({
                    'type': 'bonding_curve_complete',
                    'graduated': context.pool_data.get('graduated', False)
                })
        
        triggered = len(signals) > 0
        confidence = min(len(signals) * 0.4, 1.0)
        
        return IndicatorResult(
            indicator=self.name,
            triggered=triggered,
            confidence=confidence,
            evidence={
                'signals': signals,
                'pool_liquidity_usd': pool_liq,
                'liquidity_drop_threshold': self.liquidity_drop_threshold
            },
            explanation=f"Detected {len(signals)} exit signal(s)" if triggered else "No exit signals"
        )
    
    def _is_large_transfer(self, tx: Dict, context: DetectionContext) -> bool:
        amount = tx.get('amount', 0)
        supply = context.token_data.get('total_supply', 1)
        return amount / supply > self.large_transfer_threshold if supply > 0 else False


# === Solana Risk Scorer Factory ===
def create_solana_risk_scorer(evidence_store: EvidenceStore) -> RiskScorer:
    """Create a risk scorer configured for Solana/Pump.fun"""
    indicators = [
        EarlySnipeDetector(),
        DeployerIntelligenceDetector(evidence_store),
        WalletClusteringDetector(),
        DistributionDetector(),
        ExitDetector(),
    ]
    return RiskScorer(indicators, threshold=0.65)
