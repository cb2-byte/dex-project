# === Pump.fun Constants ===
PUMP_FUN_PROGRAM_ID = "6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P"
PUMP_FUN_GLOBAL_ACCOUNT = "4wTV1YmiEkRvAtNtsSGPtUrqRYQMe5SKy2uB4Jjaxnjf"
PUMP_CREATE_DISCRIMINATORS = {
    bytes((24, 30, 200, 40, 5, 28, 7, 119)): "create",
    bytes((214, 144, 76, 236, 95, 139, 49, 180)): "create_v2",
}
_B58_ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"


def _decode_base58(value: str) -> bytes:
    number = 0
    for char in value:
        number = number * 58 + _B58_ALPHABET.index(char)
    body = number.to_bytes((number.bit_length() + 7) // 8, "big") if number else b""
    return b"\0" * (len(value) - len(value.lstrip("1"))) + body


def _encode_base58(data: bytes) -> str:
    zeroes = len(data) - len(data.lstrip(b"\0"))
    number = int.from_bytes(data, "big")
    encoded = ""
    while number:
        number, remainder = divmod(number, 58)
        encoded = _B58_ALPHABET[remainder] + encoded
    return "1" * zeroes + encoded


def _decode_create_args(data: bytes) -> Dict[str, str]:
    if len(data) < 8 or data[:8] not in PUMP_CREATE_DISCRIMINATORS:
        return {}
    offset = 8
    values = []
    for _ in range(3):
        if offset + 4 > len(data):
            raise ValueError("truncated Borsh string length")
        length = int.from_bytes(data[offset:offset + 4], "little")
        offset += 4
        end = offset + length
        if end > len(data):
            raise ValueError("truncated Borsh string")
        values.append(data[offset:end].decode("utf-8", errors="replace"))
        offset = end
    creator = _encode_base58(data[offset:offset + 32]) if offset + 32 <= len(data) else ""
    return {"name": values[0], "symbol": values[1], "uri": values[2], "creator": creator}

# === Solana RPC Helpers ===
class SolanaRPC:
    """Simple Solana RPC client for read-only queries"""
    
    def __init__(self, rpc_url: str = "https://solana-mainnet.g.alchemy.com/v2/alch_n_9vwsJZF7GnCJcZe63MB"):
        self.rpc_url = rpc_url
        self.headers = {"Content-Type": "application/json", "User-Agent": "pennyshield/1.0"}
    
    def _request(self, method: str, params: List[Any]) -> Optional[Dict]:
        import urllib.request
        payload = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
        try:
            req = urllib.request.Request(self.rpc_url, data=payload, headers=self.headers)
            with urllib.request.urlopen(req, timeout=15) as resp:
                return json.loads(resp.read().decode())
        except Exception as e:
            print(f"[WARNING] Solana RPC {method} failed: {e}")
            return None
    
    def get_signatures_for_address(self, address: str, limit: int = 100) -> List[Dict]:
        result = self._request("getSignaturesForAddress", [address, {"limit": limit}])
        return result.get("result", []) if result else []
    
    def get_transaction(self, signature: str) -> Optional[Dict]:
        result = self._request("getTransaction", [signature, {"encoding": "jsonParsed", "maxSupportedTransactionVersion": 0}])
        return result.get("result") if result else None

    def get_recent_funding_sources(self, address: str, before_slot: Optional[int] = None,
                                   limit: int = 5) -> List[Dict[str, Any]]:
        """Find explicit, parsed System Program transfers into an address."""
        sources = []
        signatures = self.get_signatures_for_address(address, limit=max(1, min(limit, 10)))
        for signature_info in signatures:
            slot = signature_info.get('slot')
            if before_slot is not None and slot is not None and slot > before_slot:
                continue
            signature = signature_info.get('signature')
            if not signature:
                continue
            tx = self.get_transaction(signature)
            if not tx or tx.get('meta', {}).get('err'):
                continue
            message = tx.get('transaction', {}).get('message', {})
            instructions = list(message.get('instructions', []))
            for group in tx.get('meta', {}).get('innerInstructions', []):
                instructions.extend(group.get('instructions', []))
            for ix in instructions:
                parsed = ix.get('parsed') or {}
                info = parsed.get('info') or {}
                if (ix.get('program') == 'system' and parsed.get('type') == 'transfer'
                        and info.get('destination') == address and info.get('source')):
                    sources.append({
                        'address': info['source'],
                        'evidence': {
                            'signature': signature,
                            'slot': slot,
                            'block_time': tx.get('blockTime') or signature_info.get('blockTime'),
                            'lamports': info.get('lamports'),
                            'program': 'system',
                            'transfer_type': 'transfer',
                        },
                    })
            if sources:
                break
        return sources
    
    def get_account_info(self, address: str) -> Optional[Dict]:
        result = self._request("getAccountInfo", [address, {"encoding": "jsonParsed"}])
        return result.get("result") if result else None
    
    def get_token_accounts_by_owner(self, owner: str, mint: str = None) -> List[Dict]:
        params = [owner, {"programId": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"}]
        if mint:
            params[1]["mint"] = mint
        result = self._request("getTokenAccountsByOwner", params)
        return result.get("result", {}).get("value", []) if result else []


# === Pump.fun Bonding Curve Monitor ===
@dataclass
class BondingCurveState:
    """State of a Pump.fun bonding curve"""
    mint: str
    bonding_curve: str
    associated_bonding_curve: str
    virtual_sol_reserves: int = 0
    virtual_token_reserves: int = 0
    real_sol_reserves: int = 0
    real_token_reserves: int = 0
    token_total_supply: int = 0
    complete: bool = False
    creator: str = ""
    created_timestamp: float = 0
    graduated: bool = False
    graduation_timestamp: float = 0
    metadata: Dict[str, Any] = field(default_factory=dict)
    
    @property
    def current_price_sol(self) -> float:
        if self.virtual_token_reserves > 0:
            return self.virtual_sol_reserves / self.virtual_token_reserves
        return 0.0
    
    @property
    def market_cap_sol(self) -> float:
        return self.current_price_sol * self.token_total_supply
    
    @property
    def progress_to_graduation(self) -> float:
        # Pump.fun graduates at ~85 SOL in bonding curve
        if self.virtual_sol_reserves > 0:
            return min(self.virtual_sol_reserves / 85_000_000_000, 1.0)
        return 0.0


class PumpFunMonitor:
    """Monitor Pump.fun bonding curves for rug patterns"""
    
    def __init__(self, rpc: SolanaRPC, evidence_store: EvidenceStore):
        self.rpc = rpc
        self.evidence_store = evidence_store
        self.known_curves: Dict[str, BondingCurveState] = {}
        self.seen_signatures: Set[str] = set()
        self.funding_cache: Dict[str, List[Dict[str, Any]]] = {}
    
    def fetch_new_launches(self, limit: int = 50, max_retries: int = 3) -> List[BondingCurveState]:
        """Fetch recent Pump.fun launches by monitoring program transactions with rate limiting"""
        launches = []
        funding_lookups_remaining = 5
        
        try:
            # Get recent signatures for the Pump.fun program
            signatures = self.rpc.get_signatures_for_address(PUMP_FUN_PROGRAM_ID, limit=limit * 3)
            
            for i, sig_info in enumerate(signatures):
                if len(launches) >= limit:
                    break
                
                signature = sig_info.get('signature')
                slot = sig_info.get('slot')
                block_time = sig_info.get('blockTime')
                
                if not signature:
                    continue
                if signature in self.seen_signatures:
                    continue
                
                # Fetch full transaction details with retry logic
                tx = None
                for attempt in range(max_retries):
                    tx = self.rpc.get_transaction(signature)
                    if tx is not None:
                        break
                    if attempt < max_retries - 1:
                        time.sleep(0.5 * (attempt + 1))  # Exponential backoff
                
                if not tx:
                    continue

                self.seen_signatures.add(signature)
                
                # Parse for Pump.fun Create instruction
                launch_data = self._parse_create_instruction(tx, signature, slot, block_time)
                if launch_data:
                    if launch_data.mint in self.known_curves:
                        continue
                    launch_data.metadata.update({
                        'signature': signature,
                        'slot': slot,
                        'block_time': block_time,
                    })
                    if launch_data.creator in self.funding_cache:
                        funding_sources = self.funding_cache[launch_data.creator]
                    elif funding_lookups_remaining > 0:
                        funding_lookups_remaining -= 1
                        try:
                            funding_sources = self.rpc.get_recent_funding_sources(
                                launch_data.creator, before_slot=slot, limit=3
                            )
                        except Exception as funding_error:
                            print(f"[WARNING] Creator funding lookup failed: {funding_error}")
                            funding_sources = []
                        self.funding_cache[launch_data.creator] = funding_sources
                    else:
                        funding_sources = []
                    launch_data.metadata['funding_sources'] = funding_sources
                    self.known_curves[launch_data.mint] = launch_data
                    launches.append(launch_data)
                
                # Rate limiting: small delay between requests
                if i % 5 == 0:
                    time.sleep(0.1)
        
        except Exception as e:
            print(f"[WARNING] PumpFunMonitor fetch_new_launches failed: {e}")
        
        return launches
    
    def _parse_create_instruction(self, tx: Dict, signature: str, slot: int, block_time: Optional[int]) -> Optional[BondingCurveState]:
        """Parse an Anchor create/createV2 instruction from a real transaction."""
        try:
            message = tx.get('transaction', {}).get('message', {})
            account_keys = [key.get('pubkey', '') if isinstance(key, dict) else key
                            for key in message.get('accountKeys', [])]
            instructions = list(enumerate(message.get('instructions', [])))
            for group in tx.get('meta', {}).get('innerInstructions', []):
                parent_index = group.get('index', 0)
                instructions.extend((parent_index * 1000 + index, ix)
                                    for index, ix in enumerate(group.get('instructions', [])))

            for instruction_index, instruction in instructions:
                program_id = instruction.get('programId')
                program_index = instruction.get('programIdIndex')
                if not program_id and isinstance(program_index, int) and program_index < len(account_keys):
                    program_id = account_keys[program_index]
                if program_id != PUMP_FUN_PROGRAM_ID:
                    continue

                raw_data = _decode_base58(instruction.get('data', ''))
                if len(raw_data) < 8 or raw_data[:8] not in PUMP_CREATE_DISCRIMINATORS:
                    continue
                try:
                    args = _decode_create_args(raw_data)
                except (ValueError, UnicodeError):
                    continue

                accounts = []
                for account in instruction.get('accounts', []):
                    if isinstance(account, int):
                        accounts.append(account_keys[account] if account < len(account_keys) else '')
                    elif isinstance(account, dict):
                        accounts.append(account.get('pubkey', ''))
                    else:
                        accounts.append(account)

                kind = PUMP_CREATE_DISCRIMINATORS[raw_data[:8]]
                mint_index, curve_index, associated_index, user_index = (
                    (0, 2, 3, 7) if kind == 'create' else (0, 2, 3, 5)
                )
                mint = accounts[mint_index] if len(accounts) > mint_index else ''
                curve = accounts[curve_index] if len(accounts) > curve_index else ''
                associated = accounts[associated_index] if len(accounts) > associated_index else ''
                account_creator = accounts[user_index] if len(accounts) > user_index else ''
                creator = args.get('creator') or account_creator
                if not mint or not curve or not creator:
                    continue

                return BondingCurveState(
                    mint=mint,
                    bonding_curve=curve,
                    associated_bonding_curve=associated,
                    creator=creator,
                    created_timestamp=block_time if block_time else time.time(),
                    metadata={
                        **args,
                        'signature': signature,
                        'slot': slot,
                        'block_time': block_time,
                        'instruction_index': instruction_index,
                        'instruction': kind,
                    },
                )
        except Exception as exc:
            print(f"[WARNING] Failed to parse Pump.fun create instruction: {exc}")
        return None

    def parse_bonding_curve_account(self, account_data: Dict) -> Optional[BondingCurveState]:
        """Parse bonding curve account data from Pump.fun"""
        try:
            # Pump.fun bonding curve account layout (from their IDL):
            # discriminator (8 bytes) + virtual_sol_reserves (8) + virtual_token_reserves (8) +
            # real_sol_reserves (8) + real_token_reserves (8) + token_total_supply (8) +
            # complete (1) + creator (32) + padding
            
            data = account_data.get('data', [])
            if isinstance(data, list) and len(data) >= 2:
                # data[0] is base64 encoded, data[1] is encoding
                import base64
                raw = base64.b64decode(data[0])
                if len(raw) < 57:  # Minimum size
                    return None
                
                # Skip 8-byte discriminator
                offset = 8
                virtual_sol_reserves = int.from_bytes(raw[offset:offset+8], 'little'); offset += 8
                virtual_token_reserves = int.from_bytes(raw[offset:offset+8], 'little'); offset += 8
                real_sol_reserves = int.from_bytes(raw[offset:offset+8], 'little'); offset += 8
                real_token_reserves = int.from_bytes(raw[offset:offset+8], 'little'); offset += 8
                token_total_supply = int.from_bytes(raw[offset:offset+8], 'little'); offset += 8
                complete = bool(raw[offset]); offset += 1
                creator_bytes = raw[offset:offset+32]
                creator = base64.b64encode(creator_bytes).decode() if len(creator_bytes) == 32 else ""
                
                # Note: we need the mint address which isn't in this account directly
                # It would need to be passed in or derived
                return BondingCurveState(
                    mint="",  # To be filled by caller
                    bonding_curve="",
                    associated_bonding_curve="",
                    virtual_sol_reserves=virtual_sol_reserves,
                    virtual_token_reserves=virtual_token_reserves,
                    real_sol_reserves=real_sol_reserves,
                    real_token_reserves=real_token_reserves,
                    token_total_supply=token_total_supply,
                    complete=complete,
                    creator=creator
                )
        except Exception as e:
            print(f"[WARNING] Failed to parse bonding curve account: {e}")
        return None
    
    def detect_graduation(self, curve: BondingCurveState) -> bool:
        """Detect if a curve has graduated to Raydium"""
        return curve.graduated or curve.virtual_sol_reserves >= 85_000_000_000
    
    def detect_liquidity_withdrawal(self, curve: BondingCurveState, 
                                    previous: BondingCurveState) -> Optional[Dict]:
        """Detect sudden liquidity removal"""
        if previous.real_sol_reserves > 0 and curve.real_sol_reserves < previous.real_sol_reserves * 0.5:
            return {
                'type': 'liquidity_withdrawal',
                'sol_withdrawn': previous.real_sol_reserves - curve.real_sol_reserves,
                'percentage': (previous.real_sol_reserves - curve.real_sol_reserves) / previous.real_sol_reserves,
                'timestamp': time.time()
            }
        return None
    
    def detect_coordinated_sell(self, curve: BondingCurveState, 
                                 transactions: List[Dict],
                                 wallet_graph: WalletGraph) -> Optional[Dict]:
        """Detect coordinated selling from linked wallets"""
        # Group sells by cluster
        cluster_sells = defaultdict(lambda: {'volume': 0, 'wallets': set(), 'txns': []})
        
        for tx in transactions:
            # Parse sell transactions
            seller = self._extract_seller(tx)
            if seller and seller in wallet_graph.nodes:
                node = wallet_graph.nodes[seller]
                if node.cluster_id:
                    cluster_sells[node.cluster_id]['volume'] += self._extract_sol_amount(tx)
                    cluster_sells[node.cluster_id]['wallets'].add(seller)
                    cluster_sells[node.cluster_id]['txns'].append(tx)
        
        # Find clusters selling significant portion
        for cluster_id, data in cluster_sells.items():
            if data['volume'] > curve.real_sol_reserves * 0.1:  # >10% of reserves
                return {
                    'type': 'coordinated_sell',
                    'cluster_id': cluster_id,
                    'sol_volume': data['volume'],
                    'wallet_count': len(data['wallets']),
                    'wallets': list(data['wallets']),
                    'timestamp': time.time()
                }
        return None
    
    def _extract_seller(self, tx: Dict) -> Optional[str]:
        """Extract seller address from transaction"""
        # Simplified - would parse actual transaction
        return None
    
    def _extract_sol_amount(self, tx: Dict) -> int:
